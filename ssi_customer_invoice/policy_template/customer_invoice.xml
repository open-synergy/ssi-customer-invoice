<odoo noupdate="1">
<record id="policy_template_customer_invoice" model="policy.template">
    <field name="name">Standard</field>
    <field name="model_id" ref="model_customer_invoice" />
    <field
            name="state_field_id"
            search="[('model_id.model','=','customer_invoice'),('name','=','state')]"
        />
    <field name="sequence" eval="100" />
    <field name="python_code">result=True</field>
</record>

<record id="policy_template_customer_invoice_confirm" model="policy.template_detail">
    <field name="template_id" ref="policy_template_customer_invoice" />
    <field
            name="field_id"
            search="[('model_id.model','=','customer_invoice'),('name','=','confirm_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','customer_invoice'),('value','=','draft')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('customer_invoice_user_group')])]" />
    <field name="restrict_additional" eval="0" />
</record>

<record id="policy_template_customer_invoice_approve" model="policy.template_detail">
    <field name="template_id" ref="policy_template_customer_invoice" />
    <field
            name="field_id"
            search="[('model_id.model','=','customer_invoice'),('name','=','approve_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','customer_invoice'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if env.user.id in document.active_approver_user_ids.ids:
    result = True</field>
</record>

<record id="policy_template_customer_invoice_reject" model="policy.template_detail">
    <field name="template_id" ref="policy_template_customer_invoice" />
    <field
            name="field_id"
            search="[('model_id.model','=','customer_invoice'),('name','=','reject_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','customer_invoice'),('value','=','confirm')]"
        />
    <field name="restrict_user" eval="0" />
    <field name="restrict_additional" eval="1" />
    <field name="additional_python_code">result = False
if env.user.id in document.active_approver_user_ids.ids:
    result = True</field>
</record>

<record
        id="policy_template_customer_invoice_restart_approval"
        model="policy.template_detail"
    >
    <field name="template_id" ref="policy_template_customer_invoice" />
    <field
            name="field_id"
            search="[('model_id.model','=','customer_invoice'),('name','=','restart_approval_ok')]"
        />
    <field name="restrict_state" eval="1" />
    <field
            name="state_ids"
            search="[('field_id.model_id.model','=','customer_invoice'),('value','=','open')]"
        />
    <field name="restrict_user" eval="1" />
    <field name="computation_method">use_group</field>
    <field name="group_ids" eval="[(6,0,[ref('customer_invoice_validator_group')])]" />
    <field name="restrict_additional" eval="1" />
    <field
            name="additional_python_code"
        >result = not document.approval_template_id</field>
</record>

