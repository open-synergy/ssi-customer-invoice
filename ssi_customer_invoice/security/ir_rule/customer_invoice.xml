<odoo>
<!-- Internal user rule: a regular internal user only sees customer invoices
     they are themselves responsible for. -->
<record id="customer_invoice_internal_user_rule" model="ir.rule">
    <field name="name">Customer Invoice - Internal Users</field>
    <field name="model_id" ref="model_customer_invoice" />
    <field name="groups" eval="[(4, ref('base.group_user'))]" />
    <field name="domain_force">[('user_id', '=', user.id)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<!-- Data ownership rules (local customer_invoice data-ownership groups) -->
<record id="customer_invoice_company_rule" model="ir.rule">
    <field name="name">Customer Invoice - Responsible to company data</field>
    <field name="model_id" ref="model_customer_invoice" />
    <field name="groups" eval="[(4, ref('customer_invoice_company_group'))]" />
    <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record id="customer_invoice_companies_rule" model="ir.rule">
    <field
            name="name"
        >Customer Invoice - Responsible to company and all child companies data</field>
    <field name="model_id" ref="model_customer_invoice" />
    <field name="groups" eval="[(4, ref('customer_invoice_company_child_group'))]" />
    <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record id="customer_invoice_all_rule" model="ir.rule">
    <field name="name">Customer Invoice - All</field>
    <field name="model_id" ref="model_customer_invoice" />
    <field name="groups" eval="[(4, ref('customer_invoice_all_group'))]" />
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
</odoo>
