<odoo>
<!-- Local workflow category. Labelled "Customer Invoice" (not "Invoice") on
     purpose so these groups do not get confused in the UI with the
     ssi_financial_accounting "Invoice" groups that share the same parent
     category. -->
<record id="customer_invoice_workflow_module_category" model="ir.module.category">
    <field name="name">Customer Invoice</field>
    <field
            name="parent_id"
            ref="ssi_financial_accounting.financial_accounting_module_category"
        />
</record>

<record id="customer_invoice_data_ownership_module_category" model="ir.module.category">
    <field name="name">Customer Invoice</field>
    <field
            name="parent_id"
            ref="ssi_financial_accounting.financial_accounting_data_ownership_module_category"
        />
</record>
</odoo>
